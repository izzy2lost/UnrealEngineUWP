<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_gravity="start"
	android:visibility="visible"
	tools:layout_editor_absoluteY="89dp">

	<LinearLayout
		android:id="@+id/linearLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		tools:ignore="MissingConstraints">

		<Button
			android:id="@+id/buttonPause"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:onClick="onClick"
			android:text="Pause"
			android:visibility="visible" />

		<Button
			android:id="@+id/buttonBindService"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:minWidth="48dp"
			android:onClick="onClick"
			android:text="Bind Service"
			android:visibility="visible" />

		<Button
			android:id="@+id/buttonUnbindService"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:onClick="onClick"
			android:text="Unbind Service"
			android:visibility="visible" />

		<Button
			android:id="@+id/buttonStopService"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:onClick="onClick"
			android:text="Stop Service"
			android:visibility="visible" />

		<Button
			android:id="@+id/buttonMemReport"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:onClick="onClick"
			android:text="Mem Report"
			android:visibility="visible" />

	</LinearLayout>

	<LinearLayout
		android:id="@+id/layoutButtons"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="0dp"
		android:orientation="horizontal"
		android:translationY="0dp"
		app:layout_constraintTop_toBottomOf="@+id/linearLayout">

		<Button
			android:id="@+id/activateView1Button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:onClick="onClick"
			android:text="Activate View1"
			android:visibility="visible" />

		<Button
			android:id="@+id/activateView2Button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:onClick="onClick"
			android:text="Activate View2"
			android:visibility="visible" />

		<Button
			android:id="@+id/activateView3Button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:onClick="onClick"
			android:text="Activate View3"
			android:visibility="visible" />

		<Button
			android:id="@+id/restartActivityButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:minWidth="32dp"
			android:onClick="onClick"
			android:text="RestartActivity"
			android:visibility="visible" />

		<Button
			android:id="@+id/changeThemeButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:onClick="onClick"
			android:text="changeTheme"
			android:visibility="visible" />

		<Button
			android:id="@+id/resumeButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:onClick="onClick"
			android:text="Resume Service"
			android:visibility="visible" />

	</LinearLayout>

	<HorizontalScrollView
		android:id="@+id/scrollViewMiddle"
		android:contentDescription="Render Biews"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="100dp"
		android:background="#2196F3"
		app:layout_constraintTop_toTopOf="parent"
		tools:ignore="MissingConstraints">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="400dp"
			android:background="#CDDC39"
			android:orientation="horizontal">

			<TextureView
				android:id="@+id/textureView"
				android:layout_width="300dp"
				android:layout_height="match_parent" />

			<View
				android:id="@+id/divider2"
				android:layout_width="1dp"
				android:layout_height="match_parent"
				android:background="?android:attr/listDivider" />

			<TextureView
				android:id="@+id/renderView"
				android:layout_width="1000dp"
				android:layout_height="match_parent" />

			<View
				android:id="@+id/divider"
				android:layout_width="1dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:background="?android:attr/listDivider" />

			<TextureView
				android:id="@+id/renderView2"
				android:layout_width="800dp"
				android:layout_height="match_parent"
				android:layout_weight="1" />

		</LinearLayout>
	</HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>