#include "/Engine/Private/Quaternion.ush"

RWByteAddressBuffer {DataInterfaceName}_DataCollectionBuffer;

// TODO: These defines could be code-gen'd to stay in sync with our PCGComputeConstants
#define POINT_POSITION_ID 0
#define POINT_ROTATION_ID 1
#define POINT_SCALE_ID 2
#define POINT_BOUNDS_MIN_ID 3
#define POINT_BOUNDS_MAX_ID 4
#define POINT_COLOR_ID 5
#define POINT_DENSITY_ID 6
#define POINT_SEED_ID 7
#define POINT_STEEPNESS_ID 8
#define POINT_METADATA_ENTRY_ID 9

// #################### HEADER READERS ##########################

uint GetNumData_{DataInterfaceName}()
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(0);
}

uint ReadDataAddress_{DataInterfaceName}(uint DataIndex)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load((DataIndex + 1) * 4);
}

uint ReadDataId_{DataInterfaceName}(uint DataAddress)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(DataAddress + 0);
}

uint ReadDataNumAttributes_{DataInterfaceName}(uint DataAddress)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(DataAddress + 4);
}

uint ReadDataPreambleSize_{DataInterfaceName}(uint DataAddress)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(DataAddress + 8);
}

// For PointData, this is just NumPoints
uint ReadDataInfo_{DataInterfaceName}(uint DataAddress)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(DataAddress + 12);
}

bool GetThreadData_{DataInterfaceName}(uint InThreadIndex, out uint OutDataIndex, out uint OutDataAddress, out uint OutElementIndex)
{
	int ElementIndex = InThreadIndex;

	const uint NumData = GetNumData_{DataInterfaceName}();
	for (uint DataIndex = 0; DataIndex < NumData; ++DataIndex)
	{
		const uint DataAddress = ReadDataAddress_{DataInterfaceName}(DataIndex);
		const uint ElemCount = ReadDataInfo_{DataInterfaceName}(DataAddress);

		if (ElementIndex < ElemCount)
		{
			OutDataIndex = DataIndex;
			OutDataAddress = DataAddress;
			OutElementIndex = ElementIndex;

			return true;
		}

		ElementIndex -= ElemCount;
	}

	OutDataIndex = -1;
	OutDataAddress = -1;
	OutElementIndex = -1;

	return false;
}

bool GetThreadData_{DataInterfaceName}(uint InThreadIndex, out uint OutDataIndex, out uint OutElementIndex)
{
	uint DataAddressDummy = -1;
	return GetThreadData_{DataInterfaceName}(InThreadIndex, OutDataIndex, DataAddressDummy, OutElementIndex);
}

uint GetNumElements_{DataInterfaceName}()
{
	uint NumElements = 0;

	const uint NumData = GetNumData_{DataInterfaceName}();
	for (uint DataIndex = 0; DataIndex < NumData; ++DataIndex)
	{
		const uint DataAddress = ReadDataAddress_{DataInterfaceName}(DataIndex);
		NumElements += ReadDataInfo_{DataInterfaceName}(DataAddress);
	}

	return NumElements;
}

uint ReadDataAttributeHeadersAddress_{DataInterfaceName}(uint DataAddress)
{
	return DataAddress + ReadDataPreambleSize_{DataInterfaceName}(DataAddress);
}

uint ReadAttributeHeaderAddress_{DataInterfaceName}(uint AttributeHeadersAddress, uint AttributeId)
{
	return AttributeHeadersAddress + AttributeId * 8;
}

uint ReadAttributeIdAndStride_{DataInterfaceName}(uint AttributeHeaderAddress)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(AttributeHeaderAddress);
}

uint ReadAttributeId_{DataInterfaceName}(uint AttributeHeaderAddress)
{
	return ReadAttributeIdAndStride_{DataInterfaceName}(AttributeHeaderAddress) >> 8;
}

uint ReadAttributeStride_{DataInterfaceName}(uint AttributeHeaderAddress)
{
	return ReadAttributeIdAndStride_{DataInterfaceName}(AttributeHeaderAddress) & (0xFFFFFFFF >> 24);
}

uint ReadAttributeAddress_{DataInterfaceName}(uint AttributeHeaderAddress)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(AttributeHeaderAddress + 4);
}

uint ReadAttributeAddress_{DataInterfaceName}(uint InDataAddress, uint InAttributeId)
{
	const uint AttributeHeadersAddress = ReadDataAttributeHeadersAddress_{DataInterfaceName}(InDataAddress);
	const uint NumAttributes = ReadDataNumAttributes_{DataInterfaceName}(InDataAddress);

	for (uint AttributeIndex = 0; AttributeIndex < NumAttributes; ++AttributeIndex)
	{
		const uint AttributeHeaderAddress = ReadAttributeHeaderAddress_{DataInterfaceName}(AttributeHeadersAddress, AttributeIndex);

		if (ReadAttributeId_{DataInterfaceName}(AttributeHeaderAddress) == InAttributeId)
		{
			return ReadAttributeAddress_{DataInterfaceName}(AttributeHeaderAddress);
		}
	}

	return -1;
}

// #################### HEADER WRITERS ##########################

void WriteNumData_{DataInterfaceName}(uint NumData)
{
	{DataInterfaceName}_DataCollectionBuffer.Store(0, NumData);
}

void WriteDataAddress_{DataInterfaceName}(uint DataIndex, uint DataAddress)
{
	{DataInterfaceName}_DataCollectionBuffer.Store((DataIndex + 1) * 4, DataAddress);
}

void WriteDataId_{DataInterfaceName}(uint DataAddress, uint Id)
{
	{DataInterfaceName}_DataCollectionBuffer.Store(DataAddress + 0, Id);
}

void WriteDataNumAttributes_{DataInterfaceName}(uint DataAddress, uint NumAttributes)
{
	{DataInterfaceName}_DataCollectionBuffer.Store(DataAddress + 4, NumAttributes);
}

void WriteDataPreambleSize_{DataInterfaceName}(uint DataAddress, uint PreambleSize)
{
	{DataInterfaceName}_DataCollectionBuffer.Store(DataAddress + 8, PreambleSize);
}

// For PointData, this is just NumPoints
void WriteDataInfo_{DataInterfaceName}(uint DataAddress, uint Info)
{
	{DataInterfaceName}_DataCollectionBuffer.Store(DataAddress + 12, Info);
}

void WriteAttributeIdAndStride_{DataInterfaceName}(uint AttributeHeaderAddress, uint IdAndStride)
{
	{DataInterfaceName}_DataCollectionBuffer.Store(AttributeHeaderAddress, IdAndStride);
}

void WriteAttributeAddress_{DataInterfaceName}(uint AttributeHeaderAddress, uint AttributeAddress)
{
	{DataInterfaceName}_DataCollectionBuffer.Store(AttributeHeaderAddress + 4, AttributeAddress);
}

uint LoadBuffer_{DataInterfaceName}(uint Address)
{
	return {DataInterfaceName}_DataCollectionBuffer.Load(Address);
}

void StoreBuffer_{DataInterfaceName}(uint Address, uint Value)
{
	return {DataInterfaceName}_DataCollectionBuffer.Store(Address, Value);
}

// #################### ATTRIBUTE GETTERS ##########################

uint ComputeAddressHelper_{DataInterfaceName}(uint DataIndex, uint AttributeId, uint ElementIndex)
{
	const uint DataAddress = ReadDataAddress_{DataInterfaceName}(DataIndex);
	const uint AttributeHeadersAddress = ReadDataAttributeHeadersAddress_{DataInterfaceName}(DataAddress);
	const uint AttributeHeaderAddress = ReadAttributeHeaderAddress_{DataInterfaceName}(AttributeHeadersAddress, AttributeId);
	return ReadAttributeAddress_{DataInterfaceName}(AttributeHeaderAddress);
}

bool GetBool_{DataInterfaceName}(uint DataIndex, uint AttributeId, uint ElementIndex)
{
	const uint AttributeAddress = ComputeAddressHelper_{DataInterfaceName}(DataIndex, AttributeId, ElementIndex);
	return asbool({DataInterfaceName}_DataCollectionBuffer.Load(AttributeAddress + ElementIndex * 1 * 4));
}

int GetInt_{DataInterfaceName}(uint DataIndex, uint AttributeId, uint ElementIndex)
{
	const uint AttributeAddress = ComputeAddressHelper_{DataInterfaceName}(DataIndex, AttributeId, ElementIndex);
	return asint({DataInterfaceName}_DataCollectionBuffer.Load(AttributeAddress + ElementIndex * 1 * 4));
}

int GetUint_{DataInterfaceName}(uint DataIndex, uint AttributeId, uint ElementIndex)
{
	const uint AttributeAddress = ComputeAddressHelper_{DataInterfaceName}(DataIndex, AttributeId, ElementIndex);
	return {DataInterfaceName}_DataCollectionBuffer.Load(AttributeAddress + ElementIndex * 1 * 4);
}

float GetFloat_{DataInterfaceName}(uint DataIndex, uint AttributeId, uint ElementIndex)
{
	const uint AttributeAddress = ComputeAddressHelper_{DataInterfaceName}(DataIndex, AttributeId, ElementIndex);
	return asfloat({DataInterfaceName}_DataCollectionBuffer.Load(AttributeAddress + ElementIndex * 1 * 4));
}

float2 GetFloat2_{DataInterfaceName}(uint DataIndex, uint AttributeId, uint ElementIndex)
{
	const uint AttributeAddress = ComputeAddressHelper_{DataInterfaceName}(DataIndex, AttributeId, ElementIndex);
	return asfloat({DataInterfaceName}_DataCollectionBuffer.Load2(AttributeAddress + ElementIndex * 2 * 4));
}

