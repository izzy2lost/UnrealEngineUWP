{
	"TargetPlatformName": "Mac",
	"SharedLibraryExtension": "dylib",
	"ModelCompilationCommand": "${PLUGIN_DIR}/Source/ThirdParty/IREE/Bin/Mac/iree-compile",
	"ModelCompilationArguments": "--iree-input-type=auto --iree-llvmcpu-target-triple=x86_64-apple-darwin --iree-hal-target-backends=llvm-cpu --iree-llvmcpu-link-embedded=false --iree-llvmcpu-link-static --iree-llvmcpu-static-library-output-path=\"${OBJECT_PATH}\" --output-format=vm-bytecode -o \"${ADDITIONAL_OUTPUT_PATH}\" \"${INPUT_PATH}\"",
	"SharedLibraryCompilationCommand": "/usr/bin/clang++",
	"SharedLibraryCompilationArguments": "-dynamiclib -o \"${SHARED_LIB_PATH}\" \"${OBJECT_PATH}\""
}
