						{
							"name": "User Loading Time (KPIs)",
							"metrics": [
								{
									"id": "core-loading-user-editorstartuptime-kpi",
									"alias": "TotalEditorStartup"
								},
								{
									"id": "core-loading-user-loadmaptime-kpi",
