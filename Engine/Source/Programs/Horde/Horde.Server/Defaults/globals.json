{
	"dashboard": {
		"showLandingPage": true,
		"showCI": true,
		"showAgents": true,
		"showPerforceServers": true,
		"showDeviceManager": true,
		"showTests": true
	},
	"projects": [
		// Uncomment this to enable a default //UE5/Main stream with some simple CI jobs.
		// {
		//	"id": "ue5",
		//	"path": "ue5.project.json"
		// }
	],
	"compute": [
		{
			"id": "default",
			"namespaceId": "horde.compute"
		}
	],
	"storage": {
		"backends": [
			{
				"id": "default-backend",
				"type": "FileSystem",
				"baseDir": "Storage" // Default base directory is C:\ProgramData\HordeServer
			},
			{
				"id": "memory-backend", // Used for automated tests
				"type": "Memory"
			}
		],
		"namespaces": [
			{
				"id": "default",
				"backend": "default-backend"
			},
			{
				"id": "horde-artifacts",
				"prefix": "Artifacts/",
				"backend": "default-backend"
			},
			{
				"id": "horde-perforce",
				"prefix": "Perforce/",
				"backend": "default-backend"
			},
			// The 'horde-logs' namespace is used internally by Horde to store logs from the CI
			// and remote execution systems. It must be configured in order for Horde to function
			// correctly.
			{
				"id": "horde-logs",
				"prefix": "Logs/",
				"backend": "default-backend"
			},
			{
				"id": "horde-tools",
				"prefix": "Tools/",
				"backend": "default-backend"
			},
			{
				"id": "memory",
				"backend": "memory-backend",
				"enableAliases": true
			}
		]
	},
	"pools": [
		{
			"name": "Win64",
			"condition": "Platform == 'Win64'",
			"color": "Blue"
		},
		{
			"name": "Mac",
			"condition": "Platform == 'Mac'",
			"color": "Green"
		},
		{
			"name": "Linux",
			"condition": "Platform == 'Linux'",
			"color": "Orange"
		}
	],
	"networks": [
		{
			"id": "default",
			"cidrBlock": "0.0.0.0/0",
			"description": "Default network (matching all IPs)",
			"computeId": "default"
		}
	],
	"artifactTypes": [
		{
			"name": "step-output",
			"keepDays": 1
		}
	]
}
