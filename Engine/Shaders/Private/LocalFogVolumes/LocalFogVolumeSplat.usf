#include "../Common.ush"

#if SHADING_PATH_MOBILE
#define MobileSceneTextures MobileBasePass.SceneTextures 
#endif

#include "../SceneTexturesCommon.ush"



#ifndef LFV_SPLAT_VS
#define LFV_SPLAT_VS 0
#endif
#ifndef LFV_SPLAT_PS
#define LFV_SPLAT_PS 0
#endif
#ifndef LFV_TILED_VS
#define LFV_TILED_VS 0
#endif
#ifndef LFV_TILED_PS
#define LFV_TILED_PS 0
#endif



#if LFV_SPLAT_PS
#define LFV_CAN_CLIP 1
#else
#define LFV_CAN_CLIP 0
#endif
#include "LocalFogVolumeCommon.ush"



struct FLocalFogVolumeVertexOutput
{
#if LFV_SPLAT_VS || LFV_SPLAT_PS
	nointerpolation uint InstanceId : TEXCOORD0;
#endif

#if LFV_TILED_VS || LFV_TILED_PS
	nointerpolation uint TileData : TEXCOORD0;
#endif
};

#if LFV_SPLAT_VS
void LocalFogVolumeSplatVS(
	in float4 InPosition : ATTRIBUTE0,
	uint InstanceIndex : SV_InstanceID,
	out float4 OutPosition : SV_POSITION,
	out FLocalFogVolumeVertexOutput OtherVertexOutput
)
{
	ResolvedView = ResolveView();

	float4 LocalPosition = InPosition;

	FLocalFogVolumeGPUInstanceData FogInstance = GetLocalFogVolumeGPUInstanceData(InstanceIndex);

	float4x4 FogTransform = FogInstance.Transform;

	float4 WorldPosition = mul(float4(LocalPosition.xyz, 1.0f), FogTransform);

	float4 TranslatedWorldPosition = float4(WorldPosition.xyz + LWCHackToFloat(PrimaryView.PreViewTranslation), 1);

	OutPosition = mul(TranslatedWorldPosition, PrimaryView.TranslatedWorldToClip);
	OtherVertexOutput.InstanceId = InstanceIndex;
}
#endif // LFV_SPLAT_VS


#if LFV_SPLAT_PS
void LocalFogVolumeSplatPS(
	in float4 SVPos : SV_POSITION,
	in FLocalFogVolumeVertexOutput OtherVertexOutput,
	out float4 OutColor : SV_Target0)
{
	ResolvedView = ResolveView();
	uint InstanceIndex = OtherVertexOutput.InstanceId;

	float3 CamRayTranslatedWorldOrigin	= PrimaryView.TranslatedWorldCameraOrigin;
	float3 CamRayTranslatedWorldDir = normalize(SvPositionToTranslatedWorld(float4(SVPos.xy, 0.5, 1.0)));
	float3 CamRayWorldDir = CamRayTranslatedWorldDir;
	float3 CamRayWorldOrigin = CamRayTranslatedWorldOrigin - LWCHackToFloat(PrimaryView.PreViewTranslation);

#if SHADING_PATH_MOBILE
	// LookupDeviceZ with uint2 SVPos.xy as input does not work on mobile.
	float2 UV = SVPos * View.BufferSizeAndInvSize.zw;
	const float DeviceZ = LookupDeviceZ(UV);
#else
	const float DeviceZ = LookupDeviceZ(uint2(SVPos.xy));
#endif

	float3 DepthBufferTranslatedWorldPos = SvPositionToTranslatedWorld(float4(SVPos.xy, DeviceZ, 1.0));

	float4 LuminanceColorTransmittance = GetLFVInstanceContribution(
		InstanceIndex,
		CamRayWorldOrigin,
		CamRayWorldDir,
		CamRayTranslatedWorldOrigin,
		CamRayTranslatedWorldDir,
		DepthBufferTranslatedWorldPos);

	OutColor = float4(
		LuminanceColorTransmittance.rgb * PrimaryView.PreExposure,
		LuminanceColorTransmittance.a);
}
#endif // LFV_SPLAT_PS





#if LFV_TILED_VS

Buffer<uint> TileDataBuffer;

void LocalFogVolumeTiledVS(
	in uint VertexIndex : SV_VertexID,
	in uint InstanceIndex : SV_InstanceID,
	out float4 OutPosition : SV_POSITION,
	out FLocalFogVolumeVertexOutput OtherVertexOutput
)
{
	ResolvedView = ResolveView();

	uint PackedTileCoord = TileDataBuffer[InstanceIndex];
	uint2 TileCoord = LFVUnpackTile(PackedTileCoord);

	uint2 TileVertex = TileCoord * LFVTilePixelSize;
	TileVertex.x += VertexIndex == 1 || VertexIndex == 2 || VertexIndex == 4 ? LFVTilePixelSize : 0;
	TileVertex.y += VertexIndex == 2 || VertexIndex == 4 || VertexIndex == 5 ? LFVTilePixelSize : 0;

	OutPosition = float4(float2(TileVertex) * ResolvedView.ViewSizeAndInvSize.zw * float2(2.0f, -2.0f) + float2(-1.0, 1.0f), 0.5f, 1.0f);

	OtherVertexOutput.TileData = PackedTileCoord;
}
#endif // LFV_TILED_VS


#if LFV_TILED_PS
int LocalFogVolumeTileDebug;

#if USE_DEVELOPMENT_SHADERS
#include "../ColorMap.ush"
#endif

void LocalFogVolumeTiledPS(
	in float4 SVPos : SV_POSITION,
	in FLocalFogVolumeVertexOutput OtherVertexOutput,
	out float4 OutColor : SV_Target0)
{
	ResolvedView = ResolveView();

#if SHADING_PATH_MOBILE
	// LookupDeviceZ with uint2 SVPos.xy as input does not work on mobile.
	float2 UV = SVPos * View.BufferSizeAndInvSize.zw;
	float DeviceZ = LookupDeviceZ(UV);
#else
	float DeviceZ = LookupDeviceZ(uint2(SVPos.xy));
#endif
#if HAS_INVERTED_Z_BUFFER
	DeviceZ = max(0.000000000001, DeviceZ);	// Make sure SvPositionToWorld does not return bad values when DeviceZ is far=0 when using inverted z
#endif
	float3 DepthBufferTranslatedWorldPos = SvPositionToTranslatedWorld(float4(SVPos.xy, DeviceZ, 1.0));

	uint2 TilePos = LFVUnpackTile(OtherVertexOutput.TileData);

	uint LFVCount = 0;
	float4 LFVContribution = GetLFVContribution(ResolvedView, TilePos, DepthBufferTranslatedWorldPos, LFVCount);
	
	OutColor = float4(
		LFVContribution.rgb * PrimaryView.PreExposure,
		LFVContribution.a);

	bool bDoClip = true;
#if USE_DEVELOPMENT_SHADERS
	bDoClip = LocalFogVolumeTileDebug == 2;
#endif

	const float4 IdentityLuminanceTransmittance = float4(0.0, 0.0, 0.0, 1.0);
	if (all(LFVContribution == IdentityLuminanceTransmittance) && bDoClip)
	{
		clip(-1.0f);
	}

#if USE_DEVELOPMENT_SHADERS
	if (LocalFogVolumeTileDebug > 0)
	{
		float DebugTransmittance = 0.5;
		float3 DebugColor = GetHSVDebugColor(float(LFVCount)  / 4.0f);
		DebugColor = DebugColor * (1.0f - DebugTransmittance) * PrimaryView.PreExposure;

		OutColor = float4(OutColor.rgb * DebugTransmittance + DebugColor, OutColor.a * DebugTransmittance);
	}
#endif
}
#endif // LFV_TILED_PS

